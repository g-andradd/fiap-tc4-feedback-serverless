        {
          "name": "Avaliação válida, nota 9, urgência BAIXA",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"corpo traz id e urgencia\", () => {",
                  "  const corpo = pm.response.json();",
                  "  pm.expect(corpo.id).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(corpo.urgencia).to.eql(\"BAIXA\");",
                  "});"
