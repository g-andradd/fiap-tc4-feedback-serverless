<?xml version="1.0" encoding="UTF-8"?>
<!-- LambdaJsonLayout.json vem do jar powertools-logging-log4j. -->
<Configuration>
    <Appenders>
        <Console name="SaidaJson" target="SYSTEM_OUT">
            <JsonTemplateLayout eventTemplateUri="classpath:LambdaJsonLayout.json"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="SaidaJson"/>
        </Root>
    </Loggers>
</Configuration>
